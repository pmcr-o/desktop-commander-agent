{
  "schema": "pmcro.queue/v1",
  "agent": "desktop-commander-agent",
  "transport": "filesystem-spool-v1",
  "durability": "write-temp-then-atomic-move",
  "leaseSeconds": 300,
  "maxAttempts": 3,
  "retryBaseSeconds": 5,
  "ordering": "best-effort FIFO by inbox write time; correctness must not depend on global order",
  "delivery": "at-least-once",
  "deduplication": "messageId + dedupeDigest; contentDigest protects exact envelope bytes/fields",
  "powershellMinimum": "7.5",
  "jsonDatePolicy": "string",
  "iContext": {
    "writeNew": true,
    "legacyReadable": true,
    "schema": "pmcro.i-context/v1",
    "grammar": "I -> I"
  },
  "allowedKinds": [
    "pmcro.seed",
    "orchestrator.route",
    "planner.plan",
    "maker.result",
    "checker.verdict",
    "reflector.reflect",
    "agent.handoff",
    "capability.invoke",
    "capability.result",
    "skill.create.request",
    "system.halt",
    "governance.audit.reference",
    "outcome.attestation",
    "model.request",
    "model.response",
    "procedure.candidate",
    "procedure.replay",
    "evaluation.score",
    "procedure.promotion",
    "agent.identity.assertion",
    "federation.round",
    "federation.submission",
    "federation.referee.verdict",
    "federation.winner.summary",
    "confidentiality.classification",
    "confidentiality.disclosure",
    "learning.promotion.request",
    "learning.artifact",
    "resource.registration",
    "resource.resolution",
    "resource.revocation",
    "registry.verification",
    "economics.usage",
    "economics.heartbeat",
    "economics.entitlement",
    "economics.unit-summary",
    "template.bootstrap.request",
    "template.bootstrap.result",
    "dialogue.frame",
    "intent.interpretation"
  ]
}
