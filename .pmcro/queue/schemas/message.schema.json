{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.dev/schemas/message-v1.json",
  "title": "PMCR-O durable message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "messageId",
    "traceId",
    "correlationId",
    "parentMessageId",
    "causationId",
    "trailId",
    "cycleId",
    "sourceAgent",
    "targetAgent",
    "plugin",
    "skill",
    "createdAt",
    "availableAt",
    "expiresAt",
    "evidenceStatus",
    "grantRefs",
    "payload",
    "dedupeDigest",
    "contentDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "pmcro.message/v1"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "parentMessageId": {
      "type": "string"
    },
    "causationId": {
      "type": "string"
    },
    "trailId": {
      "type": "string",
      "minLength": 1
    },
    "cycleId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAgent": {
      "type": "string",
      "minLength": 1
    },
    "targetAgent": {
      "type": "string",
      "minLength": 1
    },
    "plugin": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string"
    },
    "evidenceStatus": {
      "enum": [
        "CONFIRMED",
        "NOT-YET-VERIFIED",
        "NOT-RUN"
      ]
    },
    "grantRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object"
    },
    "dedupeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
